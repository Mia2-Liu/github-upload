<view class="admin-header">
  <view class="admin-h-left">
    <text class="admin-h-role">管理员</text>
    <text class="admin-h-name">{{staffName || '王经理'}}</text>
  </view>
  <view class="admin-h-logout" bindtap="logout">退出登录</view>
</view>

<view class="admin-tabs admin-tabs-5">
  <view class="admin-tab {{tab === 'pending' ? 'on' : ''}}" data-tab="pending" bindtap="switchTab">
    待审批<text class="badge" wx:if="{{requests.length}}">{{requests.length}}</text>
  </view>
  <view class="admin-tab {{tab === 'orders' ? 'on' : ''}}" data-tab="orders" bindtap="switchTab">
    今日订单
  </view>
  <view class="admin-tab {{tab === 'summary' ? 'on' : ''}}" data-tab="summary" bindtap="switchTab">
    汇总
  </view>
  <view class="admin-tab {{tab === 'products' ? 'on' : ''}}" data-tab="products" bindtap="switchTab">
    商品
  </view>
</view>

<!-- 待审批 -->
<block wx:if="{{tab === 'pending'}}">
  <view wx:for="{{requests}}" wx:key="requestId" class="req-card">
    <view class="req-top">
      <text class="req-name">{{item.name}}</text>
      <text class="tag amber">待审批</text>
    </view>
    <view class="req-line">手机号：{{item.phoneText}}</view>
    <view class="req-line">申请园所：{{item.gardenName}}（{{item.gardenKey}}）</view>
    <view class="req-line muted">提交时间：{{item.timeText}}</view>
    <view class="req-actions">
      <view class="btn-reject" data-id="{{item.requestId}}" data-approve="0" bindtap="review">拒绝</view>
      <view class="btn-approve" data-id="{{item.requestId}}" data-approve="1" bindtap="review">通过</view>
    </view>
  </view>
  <view class="empty" wx:if="{{!requests.length}}">暂无待审批申请</view>
</block>

<!-- 今日订单 -->
<block wx:if="{{tab === 'orders'}}">
  <view class="order-head">
    <view class="order-head-row">
      <picker mode="date" value="{{ordersDate}}" bindchange="onDateChange" start="2024-01-01" end="2030-12-31">
        <view class="order-date-picker">{{ordersDateText}} ›</view>
      </picker>
      <view class="order-status-picker" bindtap="pickOrderStatus">状态：{{orderStatus}} ›</view>
    </view>
    <view class="order-stats">
      <text class="stat-item">{{orders.orderCount}} 笔</text>
      <text class="stat-item">{{orders.gardenCount}} 家园所</text>
      <text class="stat-item">¥{{orders.totalAmountText}}</text>
    </view>
  </view>

  <view class="garden-group" wx:for="{{orders.groups}}" wx:for-item="g" wx:key="gardenKey">
    <view class="garden-head">
      <text class="garden-name">{{g.gardenName}}</text>
      <text class="garden-key">{{g.gardenKey}} · {{g.orders.length}} 笔</text>
    </view>

    <view class="order-card" wx:for="{{g.orders}}" wx:for-item="o" wx:key="orderId">
      <view class="order-top">
        <view class="order-no">{{o.orderNo}}</view>
        <text class="tag order-tag-{{o.statusKey}}">{{o.status}}</text>
      </view>
      <view class="order-meta">
        <text>下单人：{{o.createdBy || '—'}}</text>
        <text>{{o.itemCount}} 个品 · ¥{{o.amountText}}</text>
      </view>
      <view class="order-meta muted">下单时间：{{o.timeText}}</view>

      <view class="order-items">
        <view class="order-item" wx:for="{{o.items}}" wx:for-item="it" wx:key="productId">
          <text class="it-name">{{it.name}}</text>
          <text class="it-qty">{{it.qty}}{{it.unit}}</text>
        </view>
      </view>

      <view class="order-actions" wx:if="{{o.canCancel || o.canRestore || o.nextStatus}}">
        <view wx:if="{{o.nextStatus}}" class="btn-next" data-id="{{o.orderId}}" data-dir="next" data-label="{{o.nextStatus}}" bindtap="updateStatus">推进到 {{o.nextStatus}}</view>
        <view wx:if="{{o.canRestore}}" class="btn-restore" data-id="{{o.orderId}}" data-dir="restore" bindtap="updateStatus">恢复</view>
        <view wx:if="{{o.canCancel}}" class="btn-cancel" data-id="{{o.orderId}}" data-dir="cancel" bindtap="updateStatus">取消</view>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!orders.groups.length}}">该日期 / 状态下没有订单</view>
</block>

<!-- 汇总 -->
<block wx:if="{{tab === 'summary'}}">
  <view class="sum-head-row">
    <picker mode="date" value="{{sumDate}}" bindchange="onSumDateChange" start="2024-01-01" end="2030-12-31">
      <view class="order-date-picker">{{sumDateText}} ›</view>
    </picker>
    <view class="sum-view-switch">
      <view class="sv-item {{sumView === 'total' ? 'on' : ''}}" data-view="total" bindtap="switchSumView">总量</view>
      <view class="sv-item {{sumView === 'garden' ? 'on' : ''}}" data-view="garden" bindtap="switchSumView">按园所</view>
      <view class="sv-item {{sumView === 'missing' ? 'on' : ''}}" data-view="missing" bindtap="switchSumView">未下单</view>
    </view>
  </view>

  <view class="stat-grid" wx:if="{{sumView === 'total'}}">
    <view class="stat"><view class="v">{{totals.orderCount}}</view><view class="l">订单数</view></view>
    <view class="stat"><view class="v">{{totals.gardenCount}}</view><view class="l">下单园所</view></view>
    <view class="stat"><view class="v">{{totals.itemCount}}</view><view class="l">品类数</view></view>
    <view class="stat"><view class="v">{{totals.amountText}}</view><view class="l">金额（元）</view></view>
  </view>

  <view class="sec" wx:if="{{sumView === 'total'}}">
    <view class="sec-title"><text>汇总清单</text><text class="sub">每件食材的下单总数</text></view>
    <view class="row-item" wx:for="{{byProduct}}" wx:key="productId">
      <view class="row-main">
        <view class="n">{{item.name}}</view>
        <view class="s">{{item.gardenCount}} 家订购</view>
      </view>
      <view class="row-val">
        <view class="n">{{item.qtyText}}</view>
        <view class="s">¥{{item.amountText}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!byProduct.length}}">当天还没有园所下单</view>
  </view>

  <!-- 按园所分拣视图 -->
  <view class="sec" wx:if="{{sumView === 'garden'}}">
    <view class="sec-title"><text>分拣视图</text><text class="sub">按园所打包，对着手机分拣</text></view>
    <view wx:for="{{byGarden}}" wx:for-item="g" wx:key="gardenKey" class="picksort-card">
      <view class="ps-head">
        <text class="ps-garden">{{g.gardenName}}</text>
        <text class="ps-sub">{{g.gardenKey}} · {{g.orderCount}} 单 · ¥{{g.amountText}}</text>
      </view>
      <view class="ps-items">
        <view wx:for="{{g.items}}" wx:for-item="it" wx:key="productId" class="ps-item">
          <text class="ps-name">{{it.name}}</text>
          <text class="ps-qty">{{it.qtyText}}</text>
        </view>
      </view>
    </view>
    <view class="empty" wx:if="{{!byGarden.length}}">当天还没有园所下单</view>
  </view>

  <!-- 未下单 -->
  <view class="sec" wx:if="{{sumView === 'missing'}}">
    <view class="sec-title"><text>未下单园所</text><text class="sub">{{missingGardens.length}} 家</text></view>
    <view class="row-item" wx:for="{{missingGardens}}" wx:key="gardenKey">
      <view class="row-main">
        <view class="n">{{item.gardenName}}</view>
        <view class="s">{{item.route || item.gardenKey}}</view>
      </view>
    </view>
    <view class="empty" wx:if="{{!missingGardens.length}}">全部园所已下单 👏</view>
  </view>
</block>

<!-- 商品维护 -->
<block wx:if="{{tab === 'products'}}">
  <view class="prod-toolbar">
    <view class="prod-tool-hint">共 {{products.length}} 类</view>
    <view class="btn-add-prod" bindtap="openNewProduct">＋ 新增食材</view>
  </view>
  <view wx:for="{{products}}" wx:for-item="cat" wx:for-index="idx" wx:key="catName" class="prod-cat">
    <view class="prod-cat-head">{{cat.catName}}</view>
    <view wx:for="{{cat.items}}" wx:for-item="p" wx:key="productId" class="prod-row prod-row-{{p.on ? 'on' : 'off'}}">
      <view class="prod-main" bindtap="openEditProduct" data-id="{{p.productId}}">
        <view class="prod-name">{{p.name}}<text class="prod-spec">{{p.spec}}</text></view>
        <view class="prod-price-row">
          <text class="prod-price">¥{{p.price}}</text>
          <text class="prod-prev" wx:if="{{p.prevPrice !== p.price && p.prevPrice}}">原 ¥{{p.prevPrice}}</text>
          <text class="prod-unit">/ {{p.unit}}</text>
        </view>
      </view>
      <view class="prod-actions">
        <view class="btn-edit" data-id="{{p.productId}}" data-name="{{p.name}}" data-price="{{p.price}}" bindtap="editPrice">改价</view>
        <view class="btn-toggle {{p.on ? 'btn-off' : 'btn-on'}}"
              data-id="{{p.productId}}" data-name="{{p.name}}" data-on="{{p.on}}"
              bindtap="toggleProduct">{{p.on ? '下架' : '上架'}}</view>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!products.length}}">商品列表为空</view>
</block>

<!-- 新增 / 编辑弹窗 -->
<view class="modal-mask" wx:if="{{modal.show}}" bindtap="closeModal"></view>
<view class="modal" wx:if="{{modal.show}}" catchtap="">
  <view class="modal-title">{{modal.isEdit ? '编辑食材' : '新增食材'}}</view>
  <view class="modal-fields">
    <view class="mf">
      <text class="mf-l">名称 *</text>
      <input class="mf-i" value="{{modal.form.name}}" placeholder="如 土豆" data-k="name" bindinput="onModalInput" />
    </view>
    <view class="mf">
      <text class="mf-l">分类 *</text>
      <picker bindchange="onCatChange" value="{{modal.catIdx}}" range="{{modal.catLabels}}">
        <view class="mf-picker">{{modal.catLabel}} ›</view>
      </picker>
    </view>
    <view class="mf">
      <text class="mf-l">规格</text>
      <input class="mf-i" value="{{modal.form.spec}}" placeholder="如 本地中号 · 1箱=40斤" data-k="spec" bindinput="onModalInput" />
    </view>
    <view class="mf-row">
      <view class="mf mf-3">
        <text class="mf-l">单位 *</text>
        <input class="mf-i" value="{{modal.form.unit}}" placeholder="斤" data-k="unit" bindinput="onModalInput" />
      </view>
      <view class="mf mf-3">
        <text class="mf-l">箱规</text>
        <input class="mf-i" value="{{modal.form.boxSize}}" type="number" placeholder="40" data-k="boxSize" bindinput="onModalInput" />
      </view>
      <view class="mf mf-3" wx:if="{{!modal.isEdit}}">
        <text class="mf-l">价格 *</text>
        <input class="mf-i" value="{{modal.form.price}}" type="digit" placeholder="3.20" data-k="price" bindinput="onModalInput" />
      </view>
    </view>
  </view>
  <view class="modal-actions">
    <view class="modal-btn cancel" bindtap="closeModal">取消</view>
    <view class="modal-btn ok" bindtap="saveModal">保存</view>
  </view>
</view>

<view class="footer-space"></view>
