page { background: #F4F6F9; }

.admin-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: #fff;
}
.admin-h-left { display: flex; align-items: center; gap: 16rpx; }
.admin-h-role {
  background: rgba(255,255,255,.25); padding: 4rpx 14rpx;
  border-radius: 100rpx; font-size: 22rpx; font-weight: 500;
}
.admin-h-name { font-size: 30rpx; font-weight: 600; }
.admin-h-logout {
  font-size: 26rpx; background: rgba(255,255,255,.2);
  padding: 10rpx 24rpx; border-radius: 100rpx;
}

.admin-tabs {
  display: flex; background: #fff; padding: 0 12rpx;
  border-bottom: 1rpx solid #EEF0F4;
}
.admin-tab {
  flex: 1; text-align: center; padding: 28rpx 0;
  font-size: 26rpx; color: #666; position: relative;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
}
.admin-tab.on { color: #059669; font-weight: 600; }
.admin-tab.on::after {
  content: ''; position: absolute; bottom: 0; left: 30%;
  width: 40%; height: 4rpx; background: #059669; border-radius: 2rpx;
}
.badge {
  background: #EF4444; color: #fff; font-size: 20rpx;
  padding: 2rpx 10rpx; border-radius: 100rpx; min-width: 32rpx;
}

.empty {
  text-align: center; padding: 80rpx 0;
  color: #9CA3AF; font-size: 26rpx;
}

/* 待审批卡片 */
.req-card {
  background: #fff; margin: 20rpx 24rpx; padding: 28rpx;
  border-radius: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.req-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.req-name { font-size: 30rpx; font-weight: 600; color: #111; }
.req-line { font-size: 26rpx; color: #4B5563; margin: 6rpx 0; }
.req-line.muted { color: #9CA3AF; font-size: 24rpx; }
.req-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.btn-approve, .btn-reject {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: 100rpx;
  font-size: 28rpx; font-weight: 500;
}
.btn-approve { background: #059669; color: #fff; }
.btn-reject { background: #FEF2F2; color: #DC2626; border: 1rpx solid #FECACA; }

.tag {
  padding: 4rpx 16rpx; border-radius: 100rpx; font-size: 22rpx; font-weight: 500;
}
.tag.amber { background: #FFF7ED; color: #C2410C; }
.order-tag-pending { background: #FFF3E0; color: #E65100; }
.order-tag-sorted { background: #E3F2FD; color: #1565C0; }
.order-tag-delivering { background: #E8F5E9; color: #2E7D32; }
.order-tag-delivered { background: #ECEFF1; color: #455A64; }
.order-tag-cancelled { background: #FFEBEE; color: #C62828; }

/* 今日订单 */
.order-head { background: #fff; padding: 24rpx 28rpx; border-bottom: 1rpx solid #EEF0F4; }
.order-head-row { display: flex; gap: 20rpx; margin-bottom: 16rpx; flex-wrap: wrap; }
.order-date-picker, .order-status-picker {
  background: #F3F4F6; padding: 12rpx 24rpx; border-radius: 100rpx;
  font-size: 26rpx; color: #374151;
}
.order-stats { display: flex; gap: 28rpx; }
.stat-item { font-size: 26rpx; color: #4B5563; }

.garden-group { margin: 20rpx 24rpx; }
.garden-head {
  display: flex; justify-content: space-between; align-items: baseline;
  margin: 20rpx 0 12rpx;
}
.garden-name { font-size: 30rpx; font-weight: 600; color: #111; }
.garden-key { font-size: 24rpx; color: #9CA3AF; }

.order-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.order-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.order-no { font-size: 24rpx; color: #6B7280; font-family: monospace; }
.order-meta { font-size: 26rpx; color: #374151; margin: 4rpx 0; display: flex; gap: 20rpx; }
.order-meta.muted { color: #9CA3AF; font-size: 24rpx; }

.order-items {
  background: #F9FAFB; border-radius: 12rpx; padding: 16rpx 20rpx;
  margin: 16rpx 0;
}
.order-item {
  display: flex; justify-content: space-between; padding: 8rpx 0;
  font-size: 26rpx; color: #374151;
}
.it-name { color: #111; }
.it-qty { color: #059669; font-weight: 500; }

.order-actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.btn-next {
  flex: 1; text-align: center; padding: 16rpx 0; border-radius: 100rpx;
  background: #059669; color: #fff; font-size: 26rpx;
}
.btn-cancel {
  padding: 16rpx 28rpx; border-radius: 100rpx; font-size: 26rpx;
  background: #FEF2F2; color: #DC2626; border: 1rpx solid #FECACA;
}
.btn-restore {
  padding: 16rpx 28rpx; border-radius: 100rpx; font-size: 26rpx;
  background: #F0FDF4; color: #16A34A; border: 1rpx solid #BBF7D0;
}

/* 汇总 */
.sum-head-row {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; padding: 20rpx 28rpx; border-bottom: 1rpx solid #EEF0F4;
}
.sum-view-switch { display: flex; background: #F3F4F6; border-radius: 100rpx; padding: 4rpx; margin-left: auto; }
.sv-item {
  padding: 10rpx 24rpx; border-radius: 100rpx;
  font-size: 24rpx; color: #6B7280;
}
.sv-item.on { background: #fff; color: #059669; font-weight: 600; box-shadow: 0 2rpx 6rpx rgba(0,0,0,.06); }

.stat-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx;
  padding: 24rpx;
}
.stat {
  background: #fff; border-radius: 16rpx; padding: 24rpx;
  text-align: center; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04);
}
.stat .v { font-size: 40rpx; font-weight: 700; color: #111; }
.stat .l { font-size: 24rpx; color: #9CA3AF; margin-top: 4rpx; }

.sec { margin: 20rpx 24rpx; background: #fff; border-radius: 16rpx; padding: 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04); }
.sec-title { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16rpx; }
.sec-title text:first-child { font-size: 28rpx; font-weight: 600; color: #111; }
.sec-title .sub { font-size: 22rpx; color: #9CA3AF; font-weight: normal; }

.row-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0; border-bottom: 1rpx solid #F3F4F6;
}
.row-item:last-child { border-bottom: 0; }
.row-main .n { font-size: 28rpx; color: #111; }
.row-main .s { font-size: 24rpx; color: #9CA3AF; margin-top: 4rpx; }
.row-val { text-align: right; }
.row-val .n { font-size: 28rpx; color: #059669; font-weight: 600; }
.row-val .s { font-size: 24rpx; color: #9CA3AF; margin-top: 4rpx; }

/* 分拣卡片 */
.picksort-card {
  margin-bottom: 20rpx; border-radius: 16rpx;
  border: 2rpx solid #D1FAE5; background: #F0FDF4; padding: 20rpx 24rpx;
}
.ps-head { margin-bottom: 16rpx; padding-bottom: 12rpx; border-bottom: 1rpx dashed #BBF7D0; }
.ps-garden { font-size: 30rpx; font-weight: 600; color: #065F46; }
.ps-sub { margin-left: 12rpx; font-size: 22rpx; color: #047857; }
.ps-items { background: #fff; border-radius: 10rpx; padding: 8rpx 20rpx; }
.ps-item { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #F3F4F6; }
.ps-item:last-child { border-bottom: 0; }
.ps-name { font-size: 28rpx; color: #111; }
.ps-qty { font-size: 28rpx; font-weight: 600; color: #059669; }

/* 商品维护 */
.prod-cat { margin: 20rpx 24rpx 0; }
.prod-cat-head {
  font-size: 26rpx; font-weight: 600; color: #059669;
  padding: 12rpx 4rpx;
}
.prod-row {
  background: #fff; border-radius: 14rpx; padding: 20rpx 24rpx;
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 12rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.03);
}
.prod-row.prod-row-off { opacity: .55; }
.prod-main { flex: 1; margin-right: 20rpx; min-width: 0; }
.prod-name { font-size: 28rpx; font-weight: 600; color: #111; display: flex; align-items: baseline; gap: 10rpx; }
.prod-spec { font-size: 22rpx; color: #9CA3AF; font-weight: normal; }
.prod-price-row { margin-top: 6rpx; display: flex; align-items: baseline; gap: 10rpx; }
.prod-price { font-size: 30rpx; color: #059669; font-weight: 700; }
.prod-prev { font-size: 22rpx; color: #9CA3AF; text-decoration: line-through; }
.prod-unit { font-size: 22rpx; color: #9CA3AF; }

.prod-actions { display: flex; gap: 10rpx; }
.btn-edit-price {
  padding: 12rpx 20rpx; border-radius: 100rpx; font-size: 24rpx;
  background: #ECFDF5; color: #059669; border: 1rpx solid #A7F3D0;
}
.btn-toggle {
  padding: 12rpx 20rpx; border-radius: 100rpx; font-size: 24rpx;
}
.btn-on { background: #FEF2F2; color: #DC2626; border: 1rpx solid #FECACA; }
.btn-off { background: #F3F4F6; color: #6B7280; border: 1rpx solid #E5E7EB; }

.footer-space { height: 60rpx; }
