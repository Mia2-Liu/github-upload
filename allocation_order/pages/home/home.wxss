.hero {
  background: var(--brand);
  color: #fff;
  padding: 32rpx 28rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.hero .hello { font-size: 26rpx; opacity: .82; }
.hero .school { font-size: 42rpx; font-weight: 600; margin-top: 4rpx; }
.hero .deliver {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .14);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.hero .deliver .b { font-size: 28rpx; font-weight: 600; }
.hero .deliver .s { font-size: 24rpx; opacity: .82; margin-top: 4rpx; }
.hero .go {
  flex: 0 0 auto;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}

.notice {
  margin: 22rpx 28rpx 0;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
}

.quick {
  display: flex;
  margin: 22rpx 28rpx 0;
  padding: 28rpx 0;
  background: #fff;
  border-radius: 24rpx;
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  font-size: 24rpx;
}
.quick-item .qi {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.tips { padding-bottom: 20rpx; }
.tip-line {
  padding: 0 28rpx 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.footer-space { height: 40rpx; }
