.repeat-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.repeat-bar .note { font-size: 24rpx; color: var(--muted); }
.btn-mini {
  padding: 8rpx 22rpx;
  border: 1rpx solid var(--brand);
  border-radius: 999rpx;
  color: var(--brand);
  font-size: 24rpx;
}

.cart-space { height: 180rpx; }

.cartbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 20rpx 24rpx 20rpx 32rpx;
  background: #1F1F26;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 40rpx rgba(23, 23, 26, .25);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cartbar .amt {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
}
.cartbar .cnt { color: #B9B9C4; font-size: 22rpx; }
.cartbar .submit {
  padding: 20rpx 44rpx;
  border-radius: 18rpx;
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.cartbar .submit.disabled { opacity: .42; }
