.login {
  min-height: 100vh;
  background: #fff;
  padding: 0 52rpx 60rpx;
}

.login-top {
  padding-top: 150rpx;
  text-align: center;
}
.login-logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 28rpx;
  border-radius: 36rpx;
  background: var(--brand);
  color: #fff;
  font-size: 52rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-name { font-size: 44rpx; font-weight: 600; }
.login-desc { font-size: 24rpx; color: var(--muted); margin-top: 12rpx; }

.login-wx {
  margin-top: 84rpx;
  height: 92rpx;
  line-height: 92rpx;
  border: 0;
  border-radius: 20rpx;
  background: #07C160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
}
.login-wx::after { border: 0; }
.login-wx.plain {
  background: var(--brand);
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-or {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 32rpx 0;
  color: #B9B9C4;
  font-size: 22rpx;
}
.login-or::before, .login-or::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: var(--line);
}

.login-alt {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: 1rpx solid #E3E3EA;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.login-input {
  height: 88rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  border: 1rpx solid #E3E3EA;
  border-radius: 18rpx;
  font-size: 28rpx;
}
.login-input-first { margin-top: 84rpx; }

.login-wx.ghost {
  margin-top: 24rpx;
  background: #fff;
  color: #07C160;
  border: 1rpx solid #07C160;
  font-size: 28rpx;
}

.login-booting {
  margin-top: 120rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}

.login-mid {
  margin-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.8;
}
.login-title {
  margin-top: 60rpx;
  text-align: center;
  font-size: 38rpx;
  font-weight: 600;
}
.login-sub {
  margin: 20rpx 0 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.8;
}
.block-text { display: block; }

.login-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx;
  height: 76rpx;
  font-size: 26rpx;
}
.login-field .label { color: var(--muted); }

.login-pending {
  margin-top: 90rpx;
  text-align: center;
  font-size: 88rpx;
}

.login-back {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
  padding: 16rpx 0;
}
