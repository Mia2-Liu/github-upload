<view class="login">
  <view class="login-top">
    <view class="login-logo">鲜</view>
    <view class="login-name">鲜达配送</view>
    <view class="login-desc">幼儿园食材下单 · 每天 07:30 前送达</view>
  </view>

  <view wx:if="{{booting}}" class="login-booting">正在登录…</view>

  <block wx:elif="{{stage === 'phone'}}">
    <input class="login-input login-input-first" type="number" maxlength="11" placeholder="请输入 11 位手机号"
           value="{{phone}}" bindinput="onPhoneInput" />
    <view class="login-wx plain" bindtap="onManualLogin">登录</view>

    <view class="login-mid">手机号在园所白名单内即可进入；登录一次后自动记住，下次免输入</view>
  </block>

  <block wx:elif="{{stage === 'apply'}}">
    <view class="login-title">绑定幼儿园</view>
    <view class="login-sub">你的手机号还没登记在本园白名单
      <text class="block-text">填写园所码提交申请，业务员审批通过后即可下单</text>
    </view>

    <view class="login-field">
      <text class="label">手机号</text>
      <text>{{phoneText}}</text>
    </view>
    <input class="login-input" placeholder="园所码，例如 GD-0001" maxlength="7"
           value="{{gardenKey}}" bindinput="onKeyInput" />
    <input class="login-input" placeholder="你的姓名（选填）"
           value="{{name}}" bindinput="onNameInput" />

    <button class="login-wx" bindtap="submitApply" loading="{{loading}}">提交绑定申请</button>
    <view class="login-back" bindtap="backToPhone">返回换手机号</view>
  </block>

  <block wx:else>
    <view class="login-pending">⏳</view>
    <view class="login-title">等待审批</view>
    <view class="login-sub">
      <text>已提交绑定申请</text>
      <text wx:if="{{pendingGarden}}" class="block-text">申请园所：{{pendingGarden}}</text>
      <text class="block-text">业务员通过后，点下方按钮即可进入</text>
    </view>

    <view class="login-wx plain" bindtap="refresh">刷新状态</view>
    <view class="login-back" bindtap="backToPhone">换个手机号</view>
  </block>
</view>
