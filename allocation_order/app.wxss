/* 全局设计变量：品牌紫 + 中性灰，与后台原型保持一致 */
page {
  --brand: #4B3FE3;
  --brand-soft: #F1F1FF;
  --bg: #F7F8FA;
  --text: #17171A;
  --muted: #7A7A86;
  --line: #F0F1F5;
  --green: #12A87A;
  --green-soft: #E8F8F2;
  --amber: #C77B09;
  --amber-soft: #FDF3E2;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, button, input {
  box-sizing: border-box;
}

.muted { color: var(--muted); }
.sm { font-size: 24rpx; }

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #F3F3F7;
  color: var(--muted);
}
.tag.green { background: var(--green-soft); color: var(--green); }
.tag.amber { background: var(--amber-soft); color: var(--amber); }
.tag.brand { background: var(--brand-soft); color: var(--brand); }

.sec {
  margin: 24rpx 28rpx 0;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.sec-title .sub { font-size: 24rpx; color: var(--muted); font-weight: 400; }

.row-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid var(--line);
}
.row-item:first-child { border-top: 0; }
.row-main { flex: 1; min-width: 0; }
.row-main .n { font-size: 28rpx; font-weight: 500; }
.row-main .s { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.row-val { font-size: 28rpx; text-align: right; }

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* 顶部横向分类 */
.cats {
  display: flex;
  gap: 14rpx;
  padding: 20rpx 28rpx;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
  white-space: nowrap;
}
.cats .cat {
  flex: 0 0 auto;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #F4F5F8;
  color: #4A4A55;
  font-size: 26rpx;
}
.cats .cat.on {
  background: var(--brand);
  color: #fff;
}

/* 商品行 */
.p-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 28rpx;
  background: #fff;
  border-top: 1rpx solid var(--line);
}
.p-thumb {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 22rpx;
  background: #F6F6FB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
}
.p-info { flex: 1; min-width: 0; }
.p-info .n { font-size: 28rpx; font-weight: 500; }
.p-info .s { font-size: 22rpx; color: var(--muted); margin-top: 2rpx; }
.p-info .pr {
  font-size: 28rpx;
  font-weight: 600;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}
.p-info .pr .unit { font-size: 22rpx; font-weight: 400; color: var(--muted); margin-left: 6rpx; }

.step { display: flex; align-items: center; }
.step .minus, .step .plus, .step .q {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}
.step .minus { border: 1rpx solid var(--line); color: var(--brand); background: #fff; }
.step .plus { background: var(--brand); color: #fff; }
.step .q { width: 60rpx; height: auto; font-size: 28rpx; font-variant-numeric: tabular-nums; }

/* 订单卡片 */
.order-card {
  margin: 20rpx 28rpx 0;
  padding: 26rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
}
.order-top { display: flex; align-items: center; justify-content: space-between; }
.order-top .no { font-size: 22rpx; color: var(--muted); }
.order-mid { font-size: 26rpx; margin-top: 12rpx; }
.order-mid.sm { font-size: 24rpx; margin-top: 6rpx; }
.order-bot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}
.order-bot .money { font-size: 32rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.link-btn { color: var(--brand); font-size: 24rpx; }

/* 底部弹层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 23, 26, .4);
  z-index: 90;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 78vh;
  overflow-y: auto;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 36rpx 24rpx;
  border-bottom: 1rpx solid var(--line);
  font-size: 30rpx;
  font-weight: 600;
}
.sheet-head .close { font-size: 40rpx; color: var(--muted); line-height: 1; }
.sheet-body { padding: 8rpx 36rpx 0; }
.dline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx dashed var(--line);
}
.dline:last-child { border-bottom: 0; }
.dline.total { font-size: 30rpx; font-weight: 600; }
